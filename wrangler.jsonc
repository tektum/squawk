{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "squawk",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "squawk",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 */4 * * *"] },
  "queues": {
    "producers": [{ "binding": "OSV_ADVISORY_JOBS", "queue": "squawk-osv-advisories" }],
    "consumers": [
      {
        "queue": "squawk-osv-advisories",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "squawk-osv-advisories-dlq",
        "max_concurrency": 10
      }
    ]
  },
  "vars": {
    "DISPATCH_ENABLED": "true",
    "DESCOPE_AUDIENCE": "https://squawk.invalid/audience",
    "DESCOPE_ISSUER": "https://squawk.invalid",
    "DESCOPE_DISCOVERY_URL": "https://squawk.invalid/.well-known/openid-configuration",
    "OSV_API_URL": "https://api.osv.dev",
    "OSV_BASE_URL": "https://storage.googleapis.com/osv-vulnerabilities"
  },
  "env": {
    "staging": {
      "name": "squawk-staging",
      "vars": { "DISPATCH_ENABLED": "true" },
      "queues": {
        "producers": [{ "binding": "OSV_ADVISORY_JOBS", "queue": "squawk-staging-osv-advisories" }],
        "consumers": [
          {
            "queue": "squawk-staging-osv-advisories",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "retry_delay": 60,
            "dead_letter_queue": "squawk-staging-osv-advisories-dlq",
            "max_concurrency": 10
          }
        ]
      }
    },
    "production": {
      "name": "squawk-production",
      "vars": { "DISPATCH_ENABLED": "true" },
      "queues": {
        "producers": [
          { "binding": "OSV_ADVISORY_JOBS", "queue": "squawk-production-osv-advisories" }
        ],
        "consumers": [
          {
            "queue": "squawk-production-osv-advisories",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "retry_delay": 60,
            "dead_letter_queue": "squawk-production-osv-advisories-dlq",
            "max_concurrency": 10
          }
        ]
      }
    }
  }
}
